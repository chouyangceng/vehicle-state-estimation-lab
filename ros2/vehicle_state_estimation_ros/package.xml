<?xml version="1.0"?>
<package format="3">
  <name>vehicle_state_estimation_ros</name>
  <version>0.2.0</version>
  <description>ROS 2 bridge and estimator node for the vehicle state estimation lab.</description>
  <maintainer email="chouyangceng@users.noreply.github.com">Cheng Chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
